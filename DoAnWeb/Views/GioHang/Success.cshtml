@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg">
                <div class="card-body text-center py-5">
                    <i class="fas fa-check-circle fa-5x text-success mb-4"></i>
                    <h2 class="fw-bold text-success mb-3">Đặt hàng thành công!</h2>
                    <p class="lead mb-4">
                        Cảm ơn quý khách <strong>@ViewBag.HoTen</strong> đã tin tưởng Việt_Sherlock Pharma.
                    </p>

                    <div class="alert alert-info mx-auto" style="max-width: 600px;">
                        <h5 class="alert-heading">Thông tin đơn hàng</h5>
                        <hr>
                        <p class="mb-1"><strong>Mã đơn hàng:</strong> #@ViewBag.MaDon</p>
                        <p class="mb-1"><strong>Ngày đặt:</strong> @ViewBag.NgayDat?.ToString("dd/MM/yyyy HH:mm")</p>
                        <p class="mb-1"><strong>Tổng tiền:</strong> <span class="text-success fw-bold">@string.Format("{0:N0}", ViewBag.TongTien) ₫</span></p>
                        <p class="mb-0"><strong>Trạng thái:</strong> <span class="badge bg-warning">Đang xử lý</span></p>
                    </div>

                    <p class="mt-4 text-muted">
                        <i class="fas fa-truck text-success me-2"></i>
                        Đơn hàng sẽ được giao trong vòng 2-3 giờ. Chúng tôi sẽ liên hệ xác nhận qua số điện thoại quý khách cung cấp.
                    </p>

                    <div class="mt-5">
                        <a href="@Url.Action("Index","Home")" class="btn btn-primary btn-lg me-3 px-5">
                            <i class="fas fa-home me-2"></i> Về trang chủ
                        </a>
                        <a href="@Url.Action("KhachHang","Admin")" class="btn btn-outline-secondary btn-lg px-5" target="_blank">
                            <i class="fas fa-users me-2"></i> Xem khách hàng (Admin)
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>