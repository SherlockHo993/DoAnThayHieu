@model List<DoAnWeb.Models.CartItem>
@{ ViewBag.Title = "Giỏ hàng";
                Layout = "~/Views/Shared/_Layout.cshtml";

                decimal tongTien = Model.Sum(x => x.ThanhTien);
                int tongSoLuong = Model.Sum(x => x.SoLuong); }

<div class="container my-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Giỏ hàng</li>
        </ol>
    </nav>

    <h2 class="fw-bold mb-4" style="color: var(--primary);">
        Giỏ hàng của bạn
        <span class="badge bg-primary fs-6 align-middle ms-2">@tongSoLuong sản phẩm</span>
    </h2>

    @if (!Model.Any())
    {<!-- Giỏ hàng trống -->
                <div class="text-center py-5">
                    <i class="fas fa-shopping-cart fa-5x text-muted mb-4"></i>
                    <h4 class="text-muted mb-4">Giỏ hàng trống</h4>
                    <a href="@Url.Action("Index","Home")" class="btn btn-primary btn-lg">
                        <i class="fas fa-arrow-left me-2"></i> Tiếp tục mua sắm
                    </a>
                </div> }
                            else
                            {
                <div class="row g-5">
                    <!-- Danh sách sản phẩm -->
                    <div class="col-lg-8">
                        <div class="card border-0 shadow-sm">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-4">Sản phẩm</th>
                                            <th class="text-center">Đơn giá</th>
                                            <th class="text-center">Số lượng</th>
                                            <th class="text-end">Thành tiền</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center">
                                    <img src="~/Content/Images/@item.HinhAnh"
                                         onerror="this.src='https://via.placeholder.com/80x80?text=@item.TenThuoc'"
                                         class="rounded me-3 shadow-sm"
                                         width="80" height="80"
                                         style="object-fit: contain; background:#f8f9fa;">
                                    <div>
                                        <h6 class="mb-1 fw-semibold">@item.TenThuoc</h6>
                                        <small class="text-muted">Mã: #@item.MaThuoc</small>
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="fw-bold">@String.Format("{0:N0}", item.DonGia) ₫</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-primary px-3 py-2" style="font-size:1.1rem;">
                                    @item.SoLuong
                                </span>
                            </td>
                            <td class="text-end fw-bold fs-5" style="color:var(--accent);">
                                @String.Format("{0:N0}", item.ThanhTien) ₫
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("Remove","GioHang", new { id = item.MaThuoc })"
                                   class="btn btn-sm btn-danger"
                                   onclick="return confirm('Xóa @item.TenThuoc khỏi giỏ hàng?')">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </td>
                        </tr>}
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="mt-4">
                            <a href="@Url.Action("Index","Home")" class="btn btn-outline-primary">
                                <i class="fas fa-arrow-left me-2"></i> Tiếp tục mua sắm
                            </a>
                        </div>
                    </div>

                    <!-- Tổng tiền & Thanh toán -->
                    <div class="col-lg-4">
                        <div class="card border-0 shadow sticky-top" style="top: 100px;">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">Tổng đơn hàng</h5>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between py-2">
                                    <span>Tạm tính (@tongSoLuong sản phẩm):</span>
                                    <strong>@String.Format("{0:N0}", tongTien) ₫</strong>
                                </div>
                                <div class="d-flex justify-content-between py-2">
                                    <span>Phí vận chuyển:</span>
                                    <strong class="text-success">Miễn phí</strong>
                                </div>
                                <hr>
                                <div class="d-flex justify-content-between py-3">
                                    <h4 class="mb-0">Tổng cộng:</h4>
                                    <h3 class="text-primary mb-0">@String.Format("{0:N0}", tongTien) ₫</h3>
                                </div>

                                <a href="@Url.Action("Checkout","GioHang")" class="btn btn-success btn-lg w-100 mt-3 shadow">
                                    <i class="fas fa-credit-card me-2"></i>
                                    Thanh toán ngay
                                </a>

                                <div class="text-center mt-3">
                                    <small class="text-muted">
                                        <i class="fas fa-shield-alt text-success me-1"></i>
                                        Thanh toán an toàn • Giao hàng trong 2h nội thành
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div> <!-- Kết thúc row -->} <!-- Kết thúc else -->
</div> <!-- Kết thúc container -->