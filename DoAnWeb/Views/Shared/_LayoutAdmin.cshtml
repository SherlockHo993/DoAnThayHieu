<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Admin Việt_Sherlock Pharma</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        body {
            background: #f8f9fa;
        }

        .sidebar {
            background: #343a40;
            min-height: 100vh;
            color: white;
        }

            .sidebar a {
                color: #adb5bd;
                padding: 15px;
            }

                .sidebar a:hover {
                    background: #495057;
                    color: white;
                }

        .content {
            margin-left: 250px;
            padding: 20px;
        }

        @@media (max-width: 768px) {
            .sidebar {
                min-height: auto;
            }

            .content {
                margin-left: 0;
            }
        }
    </style>
</head>
<body class="d-flex">
    <div class="sidebar col-md-3 col-lg-2">
        <div class="p-4 text-center border-bottom">
            <h5>ADMIN PANEL</h5>
            <small>Xin chào @Session["AdminName"]</small>
        </div>
        <a href="@Url.Action("Dashboard","Admin")" class="d-block"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <a href="@Url.Action("KhachHang","Admin")" class="d-block"><i class="fas fa-users"></i> Khách hàng</a>
        <a href="@Url.Action("DonHang","Admin")" class="d-block"><i class="fas fa-shopping-bag"></i> Đơn hàng</a>
        <a href="@Url.Action("SanPham","Admin")" class="d-block"><i class="fas fa-pills"></i> Sản phẩm</a>
        <a href="@Url.Action("Logout","Admin")" class="d-block text-danger"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a>
    </div>
    <div class="content flex-grow-1">
        <div class="container-fluid">
            @RenderBody()
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>