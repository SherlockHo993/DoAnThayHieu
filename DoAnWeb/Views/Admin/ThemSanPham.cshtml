@model DoAnWeb.Models.thuoc
@{
    ViewBag.Title = "Thêm sản phẩm mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h5 class="m-0 font-weight-bold text-primary">Thêm sản phẩm mới</h5>
        <a href="@Url.Action("SanPham","Admin")" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left me-2"></i> Quay lại danh sách
        </a>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <form method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-medium">Tên sản phẩm <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.ten_thuoc, new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(m => m.ten_thuoc, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-medium">Loại sản phẩm <span class="text-danger">*</span></label>
                @Html.DropDownListFor(m => m.ma_loai, (IEnumerable<SelectListItem>)ViewBag.LoaiThuocList, "-- Chọn loại --", new { @class = "form-select", required = "required" })
                @Html.ValidationMessageFor(m => m.ma_loai, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-medium">Đơn giá <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.don_gia, new { @class = "form-control", type = "number", step = "0.01", required = "required" })
                @Html.ValidationMessageFor(m => m.don_gia, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-medium">Số lượng</label>
                @Html.TextBoxFor(m => m.so_luong, new { @class = "form-control", type = "number" })
                @Html.ValidationMessageFor(m => m.so_luong, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-medium">Mô tả</label>
                @Html.TextAreaFor(m => m.mo_ta, new { @class = "form-control", rows = "4" })
                @Html.ValidationMessageFor(m => m.mo_ta, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-medium">Hình ảnh sản phẩm</label>
                <input type="file" name="hinh_anh" class="form-control" accept="image/*" />
                <small class="form-text text-muted">Chọn file ảnh (jpg, png, gif). Dung lượng tối đa 2MB.</small>
            </div>

            <button type="submit" class="btn btn-success">
                <i class="fas fa-save me-2"></i> Lưu sản phẩm
            </button>
        </form>
    </div>
</div>