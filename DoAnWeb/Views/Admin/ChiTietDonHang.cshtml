@model DoAnWeb.Models.don_hang
@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.ma_don;
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h5 class="m-0 font-weight-bold text-primary">
            Chi tiết đơn hàng #@Model.ma_don
        </h5>
        <a href="@Url.Action("DonHang","Admin")" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left me-2"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card-body">
        <div class="row mb-4">
            <div class="col-md-6">
                <h6 class="fw-bold text-primary mb-3">Thông tin khách hàng</h6>
                <p><strong>Họ tên:</strong> @Model.khach_hang.ho_ten</p>
                <p><strong>Số điện thoại:</strong> @Model.khach_hang.so_dien_thoai</p>
                <p><strong>Địa chỉ:</strong> @Model.khach_hang.dia_chi</p>
            </div>
            <div class="col-md-6">
                <h6 class="fw-bold text-primary mb-3">Thông tin đơn hàng</h6>
                <p><strong>Ngày đặt:</strong> @Model.ngay_dat?.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Tổng tiền:</strong> <span class="fw-bold text-success">@string.Format("{0:N0}", Model.tong_tien) ₫</span></p>

                <!-- Form cập nhật trạng thái -->
                <form method="post" action="@Url.Action("CapNhatTrangThai","Admin")" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.ma_don" />
                    <div class="input-group w-50">
                        <label class="input-group-text fw-medium">Trạng thái:</label>
                        <select name="trang_thai" class="form-select">
                            <option value="Đang xử lý" @(Model.trang_thai == "Đang xử lý" ? "selected" : "")>Đang xử lý</option>
                            <option value="Đã xác nhận" @(Model.trang_thai == "Đã xác nhận" ? "selected" : "")>Đã xác nhận</option>
                            <option value="Đang giao" @(Model.trang_thai == "Đang giao" ? "selected" : "")>Đang giao</option>
                            <option value="Đã giao" @(Model.trang_thai == "Đã giao" ? "selected" : "")>Đã giao</option>
                            <option value="Hủy đơn" @(Model.trang_thai == "Hủy đơn" ? "selected" : "") class="text-danger">Hủy đơn</option>
                        </select>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Cập nhật
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <hr class="my-4">

        <h6 class="fw-bold text-primary mb-3">Chi tiết sản phẩm</h6>
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>STT</th>
                        <th>Sản phẩm</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int stt = 1; }
                    @foreach (var ct in Model.chi_tiet_don_hang)
                    {
                        <tr>
                            <td>@stt</td>
                            <td>@ct.thuoc.ten_thuoc</td>
                            <td class="text-center">@ct.so_luong</td>
                            <td class="text-end">@string.Format("{0:N0}", ct.don_gia) ₫</td>
                            <td class="text-end fw-bold text-success">@string.Format("{0:N0}", ct.so_luong * ct.don_gia) ₫</td>
                        </tr>
                        stt++;
                    }
                </tbody>
                <tfoot>
                    <tr class="table-primary">
                        <td colspan="4" class="text-end fw-bold">Tổng cộng:</td>
                        <td class="text-end fw-bold text-primary">@string.Format("{0:N0}", Model.tong_tien) ₫</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>