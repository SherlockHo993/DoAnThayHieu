@{
    ViewBag.Title = "Quản lý khách hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Danh sách khách hàng</h6>
        <a href="@Url.Action("ThemKhachHang")" class="btn btn-success btn-sm">Thêm khách hàng</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Họ tên</th>
                        <th>Số điện thoại</th>
                        <th>Địa chỉ</th>
                        <th>Số đơn</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kh in Model)
                    {
                        <tr>
                            <td>@kh.ma_khach</td>
                            <td>@kh.ho_ten</td>
                            <td>@kh.so_dien_thoai</td>
                            <td>@kh.dia_chi</td>
                            <td>@kh.don_hang.Count</td>
                            <td>
                                <a href="@Url.Action("ChiTietKhachHang", new { id = kh.ma_khach })" class="btn btn-info btn-sm"><i class="fas fa-eye"></i></a>
                                <a href="@Url.Action("SuaKhachHang", new { id = kh.ma_khach })" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                                <a href="@Url.Action("XoaKhachHang", new { id = kh.ma_khach })" class="btn btn-danger btn-sm" onclick="return confirm('Xóa khách hàng này?')"><i class="fas fa-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>